APP_BIND_ADDRESS=127.0.0.1:3000
APP_LOG_FILTER=resume_job_matcher=info,tower_http=info
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_TTL_SECONDS=3600
APP_ARGON2_MEMORY_COST=19456
# Persistence: sqlite (durable, default), postgres (Neon/managed), or memory (volatile, tests only).
APP_PERSISTENCE=sqlite
APP_DATABASE_PATH=./data/matcher.db
# Required only when APP_PERSISTENCE=postgres. Never commit real credentials.
# APP_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Pool size for the postgres backend (must be greater than zero).
# APP_DATABASE_MAX_CONNECTIONS=5
# Auth rate limiting (sliding window per client IP).
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
APP_AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Optional OpenAI-compatible embedding endpoint. If omitted, the service uses
# deterministic local embeddings for offline development and tests.
# APP_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
# APP_EMBEDDING_API_KEY=
APP_EMBEDDING_MODEL=text-embedding-3-small
# Optional admin seeding on startup (both must be set together).
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_PASSWORD=change-me-12-chars-min
# File upload storage (outside web root).
APP_UPLOAD_DIR=./data/uploads
# Virus scan: noop is default; ClamAV placeholder scans for EICAR. Set APP_VIRUS_SCAN=clamav to enable placeholder.
# APP_VIRUS_SCAN=noop
